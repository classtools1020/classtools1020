# PostgreSQL 連線字串（Supabase / Neon / Railway / Render 皆可；雲端通常需要 ?sslmode=require）
DATABASE_URL=postgres://app:app@127.0.0.1:5432/adaptive_sports

# 伺服器埠號（多數平台會自動注入 PORT）
PORT=3000

# 正式公告網址（用於 QR Code 與邀請連結；部署後填入，例如 https://results.example.com）
PUBLIC_URL=

# 正式環境設定：production 會強制 Secure Cookie（需 HTTPS）
NODE_ENV=development

# 管理者認證碼（至少 8 個字元）。伺服器啟動時會自動建立／更新一位管理者，
# 部署後直接用這組碼登入 /staff，不需再執行任何指令。
ADMIN_CODE=
ADMIN_NAME=曾老師
